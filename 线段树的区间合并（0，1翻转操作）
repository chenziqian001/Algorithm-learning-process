#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;



const int N = 1e5 + 10;
int n, m;
struct Node {
    int l, r, len;
    int sum1, lmax1, rmax1, tmax1;
    int sum0, lmax0, rmax0, tmax0;
    int lazy;

} tr[N * 4];

Node make_empty_node() {
    Node res;
    res.l = res.r = 0;
    res.len = 0;
    res.sum1 = res.lmax1 = res.rmax1 = res.tmax1 = 0;
    res.sum0 = res.lmax0 = res.rmax0 = res.tmax0 = 0;
    res.lazy = -1;
    return res;
}


int a[N];

void push_up(Node& u, Node& l, Node& r) {
    u.sum1 = l.sum1 + r.sum1;
    u.lmax1 = (l.sum1 == l.len ? l.sum1 + r.lmax1 : l.lmax1);
    u.rmax1 = (r.sum1 == r.len ? r.sum1 + l.rmax1 : r.rmax1);
    u.tmax1 = max({ l.tmax1,r.tmax1,l.rmax1 + r.lmax1 });
    u.sum0 = l.sum0 + r.sum0;
    u.lmax0 = (l.lmax0 == l.len ? l.len + r.lmax0 : l.lmax0);
    u.rmax0 = (r.rmax0 == r.len ? r.len + l.rmax0 : r.rmax0);
    u.tmax0 = max({ l.tmax0,r.tmax0,l.rmax0 + r.lmax0 });
}

void push_up(int u) {
    push_up(tr[u], tr[u * 2], tr[u * 2 + 1]);
}

void build(int u, int l, int r) {
    tr[u].l = l;
    tr[u].r = r;
    tr[u].len = r - l + 1;
    tr[u].lazy = -1;
    if (l == r) {
        if (a[l] == 1) {
            tr[u].sum1 = tr[u].lmax1 = tr[u].rmax1 = tr[u].tmax1 = 1;
            tr[u].sum0 = tr[u].lmax0 = tr[u].rmax0 = tr[u].tmax0 = 0;
        }
        else {
            tr[u].sum0 = tr[u].lmax0 = tr[u].rmax0 = tr[u].tmax0 = 1;
            tr[u].sum1 = tr[u].lmax1 = tr[u].rmax1 = tr[u].tmax1 = 0;

        }
        return;
    }
    int mid = (l + r) / 2;
    build(u * 2, l, mid);
    build(u * 2 + 1, mid + 1, r);
    push_up(tr[u], tr[u * 2], tr[u * 2 + 1]);
}

void set_tag(int u, int val) {
    if (val == 0) {
        tr[u].sum1 = 0;
        tr[u].lmax1 = tr[u].rmax1 = tr[u].tmax1 = 0;
        tr[u].sum0 = tr[u].len;
        tr[u].lmax0 = tr[u].rmax0 = tr[u].tmax0 = tr[u].len;
        tr[u].lazy = 0;

    }
    else if (val == 1) {
        tr[u].sum1 = tr[u].len;
        tr[u].lmax1 = tr[u].rmax1 = tr[u].tmax1 = tr[u].len;
        tr[u].sum0 = 0;
        tr[u].lmax0 = tr[u].rmax0 = tr[u].tmax0 = 0;
        tr[u].lazy = 1;
    }
    else if (val == 2) {
        swap(tr[u].sum0, tr[u].sum1);
        swap(tr[u].lmax1, tr[u].lmax0);
        swap(tr[u].rmax1, tr[u].rmax0);
        swap(tr[u].tmax0, tr[u].tmax1);
        if (tr[u].lazy == 0) tr[u].lazy = 1;
        else if (tr[u].lazy == 1) tr[u].lazy = 0;
        else if (tr[u].lazy == 2 || tr[u].lazy == -1) tr[u].lazy ^= 2;
    }
}

void push_down(int u) {
    if (tr[u].lazy == -1) return;
    set_tag(u * 2, tr[u].lazy);
    set_tag(u * 2 + 1, tr[u].lazy);
    tr[u].lazy = -1;
}

void update(int u, int l, int r, int val) {
    if (tr[u].r<l || tr[u].l>r) return;
    if (l <= tr[u].l && r >= tr[u].r) {
        set_tag(u, val);
        return;
    }
    push_down(u);
    update(u * 2, l, r, val);
    update(u * 2 + 1, l, r, val);
    push_up(u);

}

Node query(int u, int l, int r) {
    if (tr[u].r<l || tr[u].l>r) return make_empty_node();
    if (l <= tr[u].l && r >= tr[u].r) {
        return tr[u];
    }
    push_down(u);
    Node left = query(u * 2, l, r);
    Node right = query(u * 2 + 1, l, r);
    if (left.len == 0) return right;
    if (right.len == 0) return left;
    Node res;
    res.l = left.l;
    res.r = right.r;
    res.len = left.len + right.len;
    push_up(res, left, right);
    return res;
}


int main() {
    cin >> n >> m;
    for (int i = 1;i <= n;i++) {
        cin >> a[i];

    }
    build(1, 1, n);


    for (int j = 0;j < m;j++) {
        int op, l, r;
        cin >> op >> l >> r;
        l++, r++;
        if (op == 0) {
            update(1, l, r, 0);
        }
        if (op == 1) {
            update(1, l, r, 1);
        }
        if (op == 2) {
            update(1, l, r, 2);
        }
        if (op == 3) {
            Node res = query(1, l, r);
            cout << res.sum1 << '\n';
        }
        if (op == 4) {
            Node res = query(1, l, r);
            cout << res.tmax1 << '\n';
        }



    }


    return 0;
}
